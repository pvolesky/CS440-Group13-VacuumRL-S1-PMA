{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "sqlite": {
      "command": "mcp-server-sqlite",
      "args": ["--db-path", "experiments/runs.db"]
    },
    "fetch": {
      "command": "mcp-server-fetch"
    }
  }
}
